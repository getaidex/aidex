{
  "name": "@aidex/catalog",
  "version": "0.1.0-alpha",
  "description": "Aidex Catalog — a queryable, pure-metadata registry describing every Engine provided by installed Feature Packs (no provider logic, no execution logic).",
  "keywords": [
    "ai",
    "catalog",
    "registry",
    "metadata",
    "discovery",
    "feature-pack"
  ],
  "license": "MIT",
  "author": "Sudheer Babu <isudheerbabu.dev@gmail.com>",
  "homepage": "https://github.com/getaidex/aidex/tree/main/packages/catalog#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/getaidex/aidex.git",
    "directory": "packages/catalog"
  },
  "bugs": {
    "url": "https://github.com/getaidex/aidex/issues"
  },
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    }
  },
  "files": [
    "dist",
    "README.md"
  ],
  "sideEffects": false,
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsc -b && tsup",
    "typecheck": "tsc -b --noEmit"
  },
  "dependencies": {
    "@aidex/core": "workspace:*",
    "@aidex/providers": "workspace:*"
  },
  "devDependencies": {
    "@aidex/engines": "workspace:*"
  },
  "engines": {
    "node": ">=18"
  }
}
