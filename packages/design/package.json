{
  "name": "@aidex/design",
  "version": "0.1.0-alpha",
  "private": true,
  "description": "Aidex Design — an Aidex Feature Pack: engine identifiers and typed request/response contracts for creative design generation (layouts, brand identity, palettes, typography, posters, flyers, business cards, banners, logos, social posts, presentations, mockups, and templates).",
  "keywords": [
    "ai",
    "design",
    "branding",
    "graphic-design",
    "feature-pack",
    "creative",
    "marketing"
  ],
  "license": "MIT",
  "author": "Sudheer Babu <isudheerbabu.dev@gmail.com>",
  "homepage": "https://github.com/getaidex/aidex/tree/main/packages/design#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/getaidex/aidex.git",
    "directory": "packages/design"
  },
  "bugs": {
    "url": "https://github.com/getaidex/aidex/issues"
  },
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "README.md"
  ],
  "sideEffects": false,
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsc -b",
    "typecheck": "tsc -b --noEmit"
  },
  "dependencies": {
    "@aidex/catalog": "0.1.0-alpha",
    "@aidex/core": "0.1.0-alpha",
    "@aidex/engines": "0.1.0-alpha",
    "@aidex/observability": "0.1.0-alpha",
    "@aidex/prompts": "0.1.0-alpha",
    "@aidex/sdk": "0.1.0-alpha",
    "@aidex/workflow": "0.1.0-alpha"
  },
  "engines": {
    "node": ">=18"
  }
}
