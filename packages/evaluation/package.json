{
  "name": "@aidex/evaluation",
  "version": "0.2.1-alpha",
  "description": "Aidex Evaluation Framework — benchmark engines for output quality, token usage, cost, latency, and success rate, and compare providers.",
  "keywords": [
    "ai",
    "evaluation",
    "benchmark",
    "llm-eval"
  ],
  "license": "MIT",
  "author": "Sudheer Babu <isudheerbabu.dev@gmail.com>",
  "homepage": "https://github.com/getaidex/aidex/tree/main/packages/evaluation#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/getaidex/aidex.git",
    "directory": "packages/evaluation"
  },
  "bugs": {
    "url": "https://github.com/getaidex/aidex/issues"
  },
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "sideEffects": false,
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsc -b && tsup",
    "typecheck": "tsc -b --noEmit",
    "prepublishOnly": "node ../../scripts/assert-pnpm.cjs"
  },
  "dependencies": {
    "@aidex/observability": "workspace:*"
  },
  "engines": {
    "node": ">=18",
    "pnpm": ">=9"
  }
}
