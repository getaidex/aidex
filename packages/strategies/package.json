{
  "name": "@aidex/strategies",
  "version": "0.2.1-alpha",
  "description": "Aidex Strategies — concrete Strategy implementations built on @aidex/core, provider-agnostic.",
  "keywords": [
    "ai",
    "llm",
    "strategy",
    "text-generation"
  ],
  "license": "MIT",
  "author": "Sudheer Babu <isudheerbabu.dev@gmail.com>",
  "homepage": "https://github.com/getaidex/aidex/tree/main/packages/strategies#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/getaidex/aidex.git",
    "directory": "packages/strategies"
  },
  "bugs": {
    "url": "https://github.com/getaidex/aidex/issues"
  },
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    }
  },
  "files": [
    "dist",
    "README.md"
  ],
  "sideEffects": false,
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsc -b && tsup",
    "typecheck": "tsc -b --noEmit"
  },
  "dependencies": {
    "@aidex/core": "workspace:*"
  },
  "devDependencies": {
    "@aidex/providers": "workspace:*"
  },
  "engines": {
    "node": ">=18"
  }
}
