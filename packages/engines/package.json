{
  "name": "@aidex/engines",
  "version": "0.2.0-alpha",
  "description": "Aidex Engines — a provider-agnostic Engine contract and central EngineRegistry for registering and executing engines by id.",
  "keywords": [
    "ai",
    "engine",
    "registry"
  ],
  "license": "MIT",
  "author": "Sudheer Babu <isudheerbabu.dev@gmail.com>",
  "homepage": "https://github.com/getaidex/aidex/tree/main/packages/engines#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/getaidex/aidex.git",
    "directory": "packages/engines"
  },
  "bugs": {
    "url": "https://github.com/getaidex/aidex/issues"
  },
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    }
  },
  "files": [
    "dist",
    "README.md"
  ],
  "sideEffects": false,
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsc -b && tsup",
    "typecheck": "tsc -b --noEmit"
  },
  "dependencies": {
    "@aidex/core": "workspace:*",
    "@aidex/providers": "workspace:*"
  },
  "engines": {
    "node": ">=18"
  }
}
