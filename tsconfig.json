{
  "compilerOptions": {
    "target": "ES2022",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "lib": ["ES2022"],
    "types": ["node"],
    "declaration": true,
    "declarationMap": true,
    "sourceMap": true,
    "composite": true,
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "resolveJsonModule": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noImplicitReturns": true,
    "noFallthroughCasesInSwitch": true
  },
  "files": [],
  "references": [
    { "path": "packages/core" },
    { "path": "packages/mcp" },
    { "path": "packages/catalog" },
    { "path": "packages/engines" },
    { "path": "packages/mcp-aidex" },
    { "path": "packages/prompts" },
    { "path": "packages/tools" },
    { "path": "packages/evaluation" },
    { "path": "packages/sdk" },
    { "path": "packages/providers" },
    { "path": "packages/strategies" },
    { "path": "packages/adapters" },
    { "path": "packages/cli" },
    { "path": "packages/plugins" },
    { "path": "packages/observability" },
    { "path": "packages/workflow" },
    { "path": "packages/memory" },
    { "path": "packages/document" },
    { "path": "packages/content" },
    { "path": "packages/design" },
    { "path": "packages/media" },
    { "path": "packages/marketing" },
    { "path": "apps/playground" },
    { "path": "examples" }
  ],
  "exclude": ["**/*.test.ts"]
}
