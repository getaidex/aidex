{
  "name": "@aidex/design",
  "version": "0.2.1-alpha",
  "description": "Aidex Design — an Aidex Feature Pack: engine identifiers and typed request/response contracts for creative design generation (layouts, brand identity, palettes, typography, posters, flyers, business cards, banners, logos, social posts, presentations, mockups, and templates).",
  "keywords": [
    "ai",
    "design",
    "branding",
    "graphic-design",
    "feature-pack",
    "creative",
    "marketing"
  ],
  "license": "MIT",
  "author": "Sudheer Babu <isudheerbabu.dev@gmail.com>",
  "homepage": "https://github.com/getaidex/aidex/tree/main/packages/design#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/getaidex/aidex.git",
    "directory": "packages/design"
  },
  "bugs": {
    "url": "https://github.com/getaidex/aidex/issues"
  },
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "sideEffects": false,
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsc -b && tsup",
    "typecheck": "tsc -b --noEmit",
    "prepublishOnly": "node ../../scripts/assert-pnpm.cjs"
  },
  "dependencies": {
    "@aidex/catalog": "workspace:*",
    "@aidex/core": "workspace:*",
    "@aidex/engines": "workspace:*",
    "@aidex/observability": "workspace:*",
    "@aidex/prompts": "workspace:*",
    "@aidex/sdk": "workspace:*",
    "@aidex/workflow": "workspace:*"
  },
  "engines": {
    "node": ">=18",
    "pnpm": ">=9"
  }
}
