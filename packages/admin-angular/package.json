{
  "name": "@aidex/admin-angular",
  "version": "0.2.1-alpha",
  "description": "Aidex Admin Angular adapter — an AdminService wrapping @aidex/admin's AdminController in an Angular Signal. No business logic, no UI components; Angular is the entire concern this package owns.",
  "keywords": [
    "ai",
    "admin",
    "angular",
    "signals"
  ],
  "license": "MIT",
  "author": "Sudheer Babu <isudheerbabu.dev@gmail.com>",
  "homepage": "https://github.com/getaidex/aidex/tree/main/packages/admin-angular#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/getaidex/aidex.git",
    "directory": "packages/admin-angular"
  },
  "bugs": {
    "url": "https://github.com/getaidex/aidex/issues"
  },
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "sideEffects": false,
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsc -b && tsup",
    "typecheck": "tsc -b --noEmit",
    "prepublishOnly": "node ../../scripts/assert-pnpm.cjs",
    "prepack": "node ../../scripts/assert-pnpm.cjs"
  },
  "dependencies": {
    "@aidex/admin": "workspace:*"
  },
  "peerDependencies": {
    "@angular/core": "^21.0.0"
  },
  "devDependencies": {
    "@aidex/ai-control": "workspace:*",
    "@aidex/connections": "workspace:*",
    "@aidex/observability": "workspace:*",
    "@angular/core": "21.2.19"
  },
  "engines": {
    "node": ">=20.19.0",
    "pnpm": ">=9"
  }
}
