{
  "name": "@aidex/plugins",
  "version": "0.2.0-alpha",
  "description": "Aidex Plugins — concrete Plugin implementations, plus the Aidex Plugin System (PluginManager) for installing plugins that register engines/strategies/prompts/tools.",
  "keywords": [
    "ai",
    "plugin",
    "extensibility",
    "lifecycle"
  ],
  "license": "MIT",
  "author": "Sudheer Babu <isudheerbabu.dev@gmail.com>",
  "homepage": "https://github.com/getaidex/aidex/tree/main/packages/plugins#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/getaidex/aidex.git",
    "directory": "packages/plugins"
  },
  "bugs": {
    "url": "https://github.com/getaidex/aidex/issues"
  },
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    }
  },
  "files": [
    "dist",
    "README.md"
  ],
  "sideEffects": false,
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsc -b && tsup",
    "typecheck": "tsc -b --noEmit"
  },
  "dependencies": {
    "@aidex/core": "workspace:*",
    "@aidex/engines": "workspace:*",
    "@aidex/prompts": "workspace:*",
    "@aidex/tools": "workspace:*"
  },
  "engines": {
    "node": ">=18"
  }
}
