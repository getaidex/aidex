{
  "name": "@aidex/admin",
  "version": "0.2.1-alpha",
  "description": "Aidex Admin — framework-agnostic composition layer over @aidex/connections, @aidex/ai-control, and @aidex/observability. Owns no state itself; the foundation for future React/Angular/Vue admin UI adapters.",
  "keywords": [
    "ai",
    "admin",
    "configuration",
    "observability"
  ],
  "license": "MIT",
  "author": "Sudheer Babu <isudheerbabu.dev@gmail.com>",
  "homepage": "https://github.com/getaidex/aidex/tree/main/packages/admin#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/getaidex/aidex.git",
    "directory": "packages/admin"
  },
  "bugs": {
    "url": "https://github.com/getaidex/aidex/issues"
  },
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "sideEffects": false,
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsc -b && tsup",
    "typecheck": "tsc -b --noEmit",
    "prepublishOnly": "node ../../scripts/assert-pnpm.cjs",
    "prepack": "node ../../scripts/assert-pnpm.cjs"
  },
  "dependencies": {
    "@aidex/core": "workspace:*",
    "@aidex/connections": "workspace:*",
    "@aidex/ai-control": "workspace:*",
    "@aidex/observability": "workspace:*"
  },
  "engines": {
    "node": ">=20.19.0",
    "pnpm": ">=9"
  }
}
