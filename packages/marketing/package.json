{
  "name": "@aidex/marketing",
  "version": "0.2.0-alpha",
  "description": "Aidex Marketing — an Aidex Feature Pack: engine identifiers and typed request/response contracts for campaign planning, SEO, social media, email marketing, and marketing analytics.",
  "keywords": [
    "ai",
    "marketing",
    "campaign",
    "seo",
    "social-media",
    "email-marketing",
    "analytics",
    "feature-pack"
  ],
  "license": "MIT",
  "author": "Sudheer Babu <isudheerbabu.dev@gmail.com>",
  "homepage": "https://github.com/getaidex/aidex/tree/main/packages/marketing#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/getaidex/aidex.git",
    "directory": "packages/marketing"
  },
  "bugs": {
    "url": "https://github.com/getaidex/aidex/issues"
  },
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    }
  },
  "files": [
    "dist",
    "README.md"
  ],
  "sideEffects": false,
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsc -b && tsup",
    "typecheck": "tsc -b --noEmit"
  },
  "dependencies": {
    "@aidex/catalog": "workspace:*",
    "@aidex/core": "workspace:*",
    "@aidex/engines": "workspace:*",
    "@aidex/observability": "workspace:*",
    "@aidex/prompts": "workspace:*",
    "@aidex/sdk": "workspace:*",
    "@aidex/workflow": "workspace:*"
  },
  "engines": {
    "node": ">=18"
  }
}
