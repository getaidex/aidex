{
  "name": "@aidex/mcp-aidex",
  "version": "0.2.1-alpha",
  "description": "Aidex MCP Aidex — the adapter layer between Aidex Engines and @aidex/mcp Tools. Any Engine becomes an MCP Tool with zero feature-pack-specific code. No protocol implementation, no providers, no AI execution.",
  "keywords": [
    "ai",
    "mcp",
    "model-context-protocol",
    "adapter",
    "engine"
  ],
  "license": "MIT",
  "author": "Sudheer Babu <isudheerbabu.dev@gmail.com>",
  "homepage": "https://github.com/getaidex/aidex/tree/main/packages/mcp-aidex#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/getaidex/aidex.git",
    "directory": "packages/mcp-aidex"
  },
  "bugs": {
    "url": "https://github.com/getaidex/aidex/issues"
  },
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "sideEffects": false,
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsc -b && tsup",
    "typecheck": "tsc -b --noEmit",
    "prepublishOnly": "node ../../scripts/assert-pnpm.cjs",
    "prepack": "node ../../scripts/assert-pnpm.cjs"
  },
  "dependencies": {
    "@aidex/core": "workspace:*",
    "@aidex/engines": "workspace:*",
    "@aidex/mcp": "workspace:*"
  },
  "engines": {
    "node": ">=20.19.0",
    "pnpm": ">=9"
  }
}
